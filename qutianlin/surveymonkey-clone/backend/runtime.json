{
  "database": {
    "data_dir": "data",
    "engine": "sqlite",
    "filename": "surveymonkey.sqlite3",
    "legacy_unbound_migration": false,
    "migration_hook": "backend.survey_model:migrate_v3",
    "seed_hook": null
  },
  "deployment": {
    "profiles": {
      "cloudflare-review": {
        "mail_adapter": "redis-resend",
        "payment_adapter": "local-sandbox",
        "persistence": "ephemeral-reset"
      },
      "docker-volume": {
        "mail_adapter": "effects-gateway",
        "payment_adapter": "local-sandbox",
        "persistence": "persistent-volume"
      },
      "offline-harbor": {
        "mail_adapter": "local-outbox",
        "payment_adapter": "local-sandbox",
        "persistence": "persistent"
      }
    }
  },
  "mail": {
    "purposes": {
      "password-reset": {
        "body": "Your password reset code is ${code}.",
        "expiry": "This code expires in ${minutes} minutes.",
        "footer": "Ignore this message if you did not contact SurveyMonkey.",
        "lead": "A password reset was requested for SurveyMonkey.",
        "required_variables": [
          "code",
          "minutes"
        ],
        "secret_variables": [
          "code"
        ],
        "subject": "Reset your SurveyMonkey password",
        "template_id": "surveymonkey.password-reset.v1"
      },
      "registration": {
        "body": "Your verification code is ${code}.",
        "expiry": "This code expires in ${minutes} minutes.",
        "footer": "This code is only for SurveyMonkey.",
        "lead": "Finish creating your SurveyMonkey account.",
        "required_variables": [
          "code",
          "minutes"
        ],
        "secret_variables": [
          "code"
        ],
        "subject": "Verify your SurveyMonkey account",
        "template_id": "surveymonkey.registration.v1"
      },
      "response-digest": {
        "body": "${summary}",
        "expiry": "View your survey results: ${url}",
        "footer": "Manage response alerts in your SurveyMonkey notification preferences.",
        "lead": "Your surveys received new responses yesterday.",
        "required_variables": [
          "summary",
          "url"
        ],
        "secret_variables": [],
        "subject": "Your SurveyMonkey daily response summary",
        "template_id": "surveymonkey.response-digest.v1"
      }
    },
    "sender": {
      "address_env": "WEBSITEBENCH_SMTP_FROM",
      "display_name": "SurveyMonkey"
    }
  },
  "payments": {
    "currency": "CAD",
    "default_adapter": "local-sandbox",
    "local_sandbox": {
      "scenarios": [
        {
          "display_label": "Simulated approval",
          "id": "sandbox-approved",
          "outcome": "approved"
        },
        {
          "display_label": "Simulated decline",
          "id": "sandbox-declined",
          "outcome": "declined"
        },
        {
          "display_label": "Simulated retry",
          "id": "sandbox-retry",
          "outcome": "retryable"
        }
      ]
    },
    "stripe_test": null
  },
  "schema_version": "websitebench.site-backend-runtime.v1",
  "session": {
    "host_only": true,
    "http_only": true,
    "same_site": "Lax",
    "secure": true
  },
  "site": {
    "id": "surveymonkey",
    "label": "SurveyMonkey",
    "public_origin": "https://surveymonkey.clone.test"
  }
}
