{
  "database": {
    "data_dir": "data",
    "engine": "sqlite",
    "filename": "ifttt.sqlite3",
    "legacy_unbound_migration": false,
    "migration_hook": "backend.automation:migrate_v1",
    "seed_hook": null
  },
  "deployment": {
    "profiles": {
      "cloudflare-review": {
        "mail_adapter": "redis-resend",
        "payment_adapter": "local-sandbox",
        "persistence": "ephemeral-reset"
      },
      "docker-volume": {
        "mail_adapter": "effects-gateway",
        "payment_adapter": "local-sandbox",
        "persistence": "persistent-volume"
      },
      "offline-harbor": {
        "mail_adapter": "local-outbox",
        "payment_adapter": "local-sandbox",
        "persistence": "persistent"
      }
    }
  },
  "mail": {
    "purposes": {
      "password-reset": {
        "body": "Your password reset code is ${code}.",
        "expiry": "This code expires in ${minutes} minutes.",
        "footer": "Ignore this message if you did not contact IFTTT.",
        "lead": "A password reset was requested for IFTTT.",
        "required_variables": [
          "code",
          "minutes"
        ],
        "secret_variables": [
          "code"
        ],
        "subject": "Reset your IFTTT password",
        "template_id": "ifttt.password-reset.v1"
      },
      "registration": {
        "body": "Your verification code is ${code}.",
        "expiry": "This code expires in ${minutes} minutes.",
        "footer": "This code is only for IFTTT.",
        "lead": "Finish creating your IFTTT account.",
        "required_variables": [
          "code",
          "minutes"
        ],
        "secret_variables": [
          "code"
        ],
        "subject": "Verify your IFTTT account",
        "template_id": "ifttt.registration.v1"
      },
      "email-change": {
        "template_id": "ifttt.email-change.v1",
        "subject": "Verify your new IFTTT email",
        "lead": "Confirm your new local email address.",
        "body": "Your verification code is ${code}.",
        "expiry": "This code expires in ${minutes} minutes.",
        "footer": "This code is only for the local IFTTT site.",
        "required_variables": [
          "code",
          "minutes"
        ],
        "secret_variables": [
          "code"
        ]
      },
      "passwordless-signin": {
        "template_id": "ifttt.passwordless-signin.v1",
        "subject": "Your local IFTTT sign-in code",
        "lead": "Sign in through the local identity adapter.",
        "body": "Your verification code is ${code}.",
        "expiry": "This code expires in ${minutes} minutes.",
        "footer": "This code is only for the local IFTTT site.",
        "required_variables": [
          "code",
          "minutes"
        ],
        "secret_variables": [
          "code"
        ]
      },
      "data-export": {
        "template_id": "ifttt.data-export.v1",
        "subject": "Your local IFTTT data export",
        "lead": "Your local IFTTT account data is attached.",
        "body": "The export contains your account preferences, Applets and activity.",
        "expiry": "Keep this file private.",
        "footer": "This export is from your local IFTTT site.",
        "required_variables": [],
        "secret_variables": []
      },
      "account-deletion": {
        "template_id": "ifttt.account-deletion.v1",
        "subject": "Confirm deletion of your local IFTTT account",
        "lead": "Confirm permanent deletion of your local IFTTT account.",
        "body": "Your verification code is ${code}.",
        "expiry": "This code expires in ${minutes} minutes.",
        "footer": "This code is only for the local IFTTT site.",
        "required_variables": [
          "code",
          "minutes"
        ],
        "secret_variables": [
          "code"
        ]
      }
    },
    "sender": {
      "address_env": "RESEND_FROM_EMAIL",
      "display_name": "IFTTT"
    }
  },
  "payments": {
    "currency": "USD",
    "default_adapter": "local-sandbox",
    "local_sandbox": {
      "scenarios": [
        {
          "display_label": "Simulated approval",
          "id": "sandbox-approved",
          "outcome": "approved"
        },
        {
          "display_label": "Simulated decline",
          "id": "sandbox-declined",
          "outcome": "declined"
        },
        {
          "display_label": "Simulated retry",
          "id": "sandbox-retry",
          "outcome": "retryable"
        }
      ]
    },
    "stripe_test": null
  },
  "schema_version": "websitebench.site-backend-runtime.v1",
  "session": {
    "host_only": true,
    "http_only": true,
    "same_site": "Lax",
    "secure": true
  },
  "site": {
    "id": "ifttt",
    "label": "IFTTT",
    "public_origin": "https://ifttt.offline.invalid"
  }
}
