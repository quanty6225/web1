nas desses aplicativos ao longo dos anos, sempre migrando para o pr\xf3ximo porque o anterior era muito b\xe1sico, muito complexo, muito lento, muito desajeitado, muito feio, muito caro etc. Mas uma vez eu descobri o TickTick cerca de um ano atr\xe1s, eu nunca mais mudei.",homepage_media_wirecutter_comment:"TickTick \xe9 o melhor aplicativo de lista de tarefas, gra\xe7as \xe0 sua organiza\xe7\xe3o de projeto simples e estruturada, integra\xe7\xe3o de calend\xe1rio perfeita e flexibilidade para se encaixar em muitos fluxos de trabalho diferentes, em vez de for\xe7\xe1-lo a organizar seu trabalho de uma determinada maneira.",homepage_user_comment_title:"Eles todos est\xe3o adorando",homepage_startup_title:"Pronto para ser mais produtivo?",homepage_startup_btn:"Entre no %s agora"}},mt=function(){return(0,u.Z)(lt)},dt=t(61592),_t=t.n(dt),ut=function(e){(0,d.Z)(e);var a=(0,w.Z)().isLogin,t=mt(),r=t.getStr,i=t.getProductName;return(0,M.jsxs)("div",{className:f()(_t().introContainer,"container"),children:[(0,M.jsxs)("div",{className:_t().introText,children:[(0,M.jsxs)("div",{className:_t().introTitle,children:[(0,M.jsx)("h2",{children:r("homepage_intro_title_1")}),(0,M.jsx)("h2",{children:r("homepage_intro_title_2")}),(0,M.jsx)("h2",{className:_t().introTitleMobile,children:r("homepage_intro_title_mobile_1")}),(0,M.jsx)("h2",{className:_t().introTitleMobile,children:r("homepage_intro_title_mobile_2")})]}),(0,M.jsx)("div",{className:_t().introDesc,children:(0,M.jsx)("p",{className:"subtitle",children:i("homepage_intro_desc")})}),(0,M.jsxs)("div",{className:_t().introButtons,children:[!a&&(0,M.jsx)(b.Z,{weight:"bold",href:"/signup",className:_t().introButton,children:r("sign_create_free_account")}),(0,M.jsx)(b.Z,{weight:"bold",type:"secondary",href:"/download",className:_t().introButton,children:i("homepage_intro_download")})]})]}),(0,M.jsx)("div",{className:_t().introImage,children:(0,M.jsx)(x.Z,{src:"/res/home/common/header.png",width:1360,height:962})})]})},pt=t(56363),ht