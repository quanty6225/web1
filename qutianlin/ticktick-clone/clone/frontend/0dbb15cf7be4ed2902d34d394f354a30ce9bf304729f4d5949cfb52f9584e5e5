50 \u963f\u66fc\n\ud83c\uddf5\ud83c\udde6=>\u65d7 \u5df4\u62ff\u9a6c,\u65d7\u5b50 \u5df4\u62ff\u99ac\n\ud83c\uddf5\ud83c\uddea=>\u65d7 \u79d8\u9c81,\u65d7\u5b50 \u79d8\u9b6f\n\ud83c\uddf5\ud83c\uddeb=>\u65d7 \u6cd5\u5c5e\u6ce2\u5229\u5c3c\u897f\u4e9a,\u65d7\u5b50 \u6cd5\u5c6c\u73bb\u91cc\u5c3c\u897f\u4e9e,\u65d7\u5b50 \u6cd5\u5c6c\u6ce2\u5229\u5c3c\u897f\u4e9e\n\ud83c\uddf5\ud83c\uddec=>\u65d7 \u5df4\u5e03\u4e9a\u65b0\u51e0\u5185\u4e9a,\u65d7\u5b50 \u5df4\u5e03\u4e9e\u7d10\u5e7e\u5167\u4e9e,\u65d7\u5b50 \u5df4\u5e03\u4e9e\u65b0\u5e7e\u5167\u4e9e\n\ud83c\uddf5\ud83c\udded=>\u65d7 \u83f2\u5f8b\u5bbe,\u65d7\u5b50 \u83f2\u5f8b\u8cd3\n\ud83c\uddf5\ud83c\uddf0=>\u65d7 \u5df4\u57fa\u65af\u5766,\u65d7\u5b50 \u5df4\u57fa\u65af\u5766\n\ud83c\uddf5\ud83c\uddf1=>\u65d7 \u6ce2\u5170,\u65d7\u5b50 \u6ce2\u862d\n\ud83c\uddf5\ud83c\uddf2=>\u65d7 \u5723\u76ae\u57c3\u5c14\u548c\u5bc6\u514b\u9686\u7fa4\u5c9b,\u65d7\u5b50 \u8056\u76ae\u57c3\u8207\u5bc6\u514b\u9686\u7fa4\u5cf6\n\ud83c\uddf5\ud83c\uddf3=>\u65d7 \u76ae\u7279\u51ef\u6069\u7fa4\u5c9b,\u65d7\u5b50 \u76ae\u7279\u80af\u7fa4\u5cf6,\u65d7\u5b50 \u76ae\u7279\u51f1\u6069\u5cf6\n\ud83c\uddf5\ud83c\uddf7=>\u65d7 \u6ce2\u591a\u9ece\u5404,\u65d7\u5b50 \u6ce2\u591a\u9ece\u5404\n\ud83c\uddf5\ud83c\uddf8=>\u65d7 \u5df4\u52d2\u65af\u5766\u9886\u571f,\u65d7\u5b50 \u5df4\u52d2\u65af\u5766\u81ea\u6cbb\u5340,\u65d7\u5b50 \u5df4\u52d2\u65af\u5766\u9818\u571f\n\ud83c\uddf5\ud83c\uddf9=>\u65d7 \u8461\u8404\u7259,\u65d7\u5b50 \u8461\u8404\u7259\n\ud83c\uddf5\ud83c\uddfc=>\u65d7 \u5e15\u52b3,\u65d7\u5b50 \u5e1b\u7409\n\ud83c\uddf5\ud83c\uddfe=>\u65d7 \u5df4\u62c9\u572d,\u65d7\u5b50 \u5df4\u62c9\u572d\n\ud83c\uddf6\ud83c\udde6=>\u65d7 \u5361\u5854\u5c14,\u65d7\u5b50 \u5361\u9054,\u65d7\u5b50 \u5361\u5854\u723e\n\ud83c\uddf7\ud83c\uddea=>\u65d7 \u7559\u5c3c\u6c6a,\u65d7\u5b50 \u7559\u5c3c\u65fa\n\ud83c\uddf7\ud83c\uddf4=>\u65d7 \u7f57\u9a6c\u5c3c\u4e9a,\u65d7\u5b50 \u7f85\u99ac\u5c3c\u4e9e\n\ud83c\uddf7\ud83c\uddf8=>\u65d7 \u585e\u5c14\u7ef4\u4e9a,\u