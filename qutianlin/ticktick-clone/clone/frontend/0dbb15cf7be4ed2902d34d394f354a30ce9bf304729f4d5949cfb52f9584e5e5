50 \u591a\u7c73\u5c3c\u52a0\u5171\u548c\u570b\n\ud83c\udde9\ud83c\uddff=>\u65d7 \u963f\u5c14\u53ca\u5229\u4e9a,\u65d7\u5b50 \u963f\u723e\u53ca\u5229\u4e9e\n\ud83c\uddea\ud83c\udde6=>\u65d7 \u4f11\u8fbe\u53ca\u6885\u5229\u5229\u4e9a,\u65d7\u5b50 \u4f11\u9054\u8207\u6885\u5229\u5229\u4e9e\n\ud83c\uddea\ud83c\udde8=>\u65d7 \u5384\u74dc\u591a\u5c14,\u65d7\u5b50 \u5384\u74dc\u591a,\u65d7\u5b50 \u5384\u74dc\u591a\u723e\n\ud83c\uddea\ud83c\uddea=>\u65d7 \u7231\u6c99\u5c3c\u4e9a,\u65d7\u5b50 \u611b\u6c99\u5c3c\u4e9e\n\ud83c\uddea\ud83c\uddec=>\u65d7 \u57c3\u53ca,\u65d7\u5b50 \u57c3\u53ca\n\ud83c\uddea\ud83c\udded=>\u65d7 \u897f\u6492\u54c8\u62c9,\u65d7\u5b50 \u897f\u6492\u54c8\u62c9\n\ud83c\uddea\ud83c\uddf7=>\u65d7 \u5384\u7acb\u7279\u91cc\u4e9a,\u65d7\u5b50 \u5384\u5229\u5782\u4e9e,\u65d7\u5b50 \u5384\u7acb\u7279\u91cc\u4e9e\n\ud83c\uddea\ud83c\uddf8=>\u65d7 \u897f\u73ed\u7259,\u65d7\u5b50 \u897f\u73ed\u7259\n\ud83c\uddea\ud83c\uddf9=>\u65d7 \u57c3\u585e\u4fc4\u6bd4\u4e9a,\u65d7\u5b50 \u8863\u7d22\u6bd4\u4e9e,\u65d7\u5b50 \u57c3\u585e\u4fc4\u6bd4\u4e9e\n\ud83c\uddea\ud83c\uddfa=>\u65d7 \u6b27\u76df,\u65d7\u5b50 \u6b50\u76df\n\ud83c\uddeb\ud83c\uddee=>\u65d7 \u82ac\u5170,\u65d7\u5b50 \u82ac\u862d\n\ud83c\uddeb\ud83c\uddef=>\u65d7 \u6590\u6d4e,\u65d7\u5b50 \u6590\u6fdf\n\ud83c\uddeb\ud83c\uddf0=>\u65d7 \u798f\u514b\u5170\u7fa4\u5c9b,\u65d7\u5b50 \u798f\u514b\u862d\u7fa4\u5cf6\n\ud83c\uddeb\ud83c\uddf2=>\u65d7 \u5bc6\u514b\u7f57\u5c3c\u897f\u4e9a,\u65d7\u5b50 \u5bc6\u514b\u7f85\u5c3c\u897f\u4e9e\n\ud83c\uddeb\ud83c\uddf4=>\u65d7 \u6cd5\u7f57\u7fa4\u5c9b,\u65d7\u5b50 \u6cd5\u7f85\u7fa4\u5cf6\n\ud83c\uddeb\ud83c\uddf7=>\u65d7 \u6cd5\u56fd,\u65d7\u5b50 \u6cd5\u570b\n\ud83c\uddec\ud83c\udde6=>\u65d7 \u52a0\u84ec,\u65d7\u5b50 \u52a0\u5f6d,\u65d7\u5b50 \u52a0\u84ec\n\ud83c\uddec\ud83c\udde7=>\u65d7 \u82f1\u56fd,\u65d7\u5b50 \u82f1\u570b\n\ud83c\uddec\ud83c\udde9=>\u65d7 \u683c\u6797\u7eb3\u8fbe,\u65d7\u5b50 \u683c\u745e\u90a3\u9054,\u65d7\u5b50 \u683c\u6797\u7d0d\u9054\n\ud83c\uddec\ud83c\uddea=>\u65d7 \u683c\u9c81\u5409\u4e9a,\u65d7\u5b50 \u55ac\u6cbb\u4e9e,\u65d7\u5b50 \u683c\u9b6f\u5409\u4e9e\n\ud83c\uddec\ud83c\uddeb=>\u65d7 \u6cd5\u5c5e\u572d\u4e9a\u90a3,\u65d7\u5b50 \u6cd5\u5c6c\u572d\u4e9e\u90a3\n\ud83c\uddec\ud83c\uddec=>\u65d7 \u6839\u897f\u5c9b,\u65d7\u5b50 \u6839\u606f\n\ud83c\uddec\ud83c\udded=>\u65d7 \u52a0\u7eb3,\u65d7\u5b50 \u8fe6\u7d0d,\u65d7\u5b50 \u52a0\u7d0d\n\ud83c\uddec\ud83c\uddee=>\u65d7 \u76f4\u5e03\u7f57\u9640,\u65d7\u5b50 \u76f4\u5e03\u7f85\u9640\n\ud83c\uddec\ud83c\uddf1=>\u65d7 \u683c\u9675\u5170,\u65d7\u5b50 \u683c\u9675\u862d\n\ud83c\uddec\ud83c\uddf2=>\u65d7 \u5188\u6bd4\u4e9a,\u65d7\u5b50 \u7518\u6bd4\u4e9e,\u65d7\u5b50 \u5ca1\u6bd4\u4e9e\n\ud83c\uddec\ud83c\uddf3=>\u65d7 \u51e0\u5185\u4e9a,\u65d7\u5b50 \u5e7e\u5167\u4e9e\n\ud83c\uddec\ud83c\uddf5=>\u65d7 \u74dc\u5fb7\u7f57\u666e,\u65d7\u5b50 \u74dc\u5730\u6d1b\u666e\n\ud83c\uddec\ud83c\uddf6=>\u65d7 \u8d64\u9053\u51e0\u5185\u4e9a,\u65d7\u5b50 \u8d64\u9053\u5e7e\u5167\u4e9e\n\ud83c\uddec\ud83c\uddf7=>\u65d7 \u5e0c\u814a,\u65d7\u5b50 \u5e0c\u81d8\n\ud83c\uddec\ud83c\uddf8=>\u65d7 \u5357\u4e54\u6cbb\u4e9a\u548c\u5357\u6851\u5a01\u5947\u7fa4\u5c9b,\u65d7\u5b50 \u5357\u55ac\u6cbb\u4e9e\u8207\u5357\u4e09\u660e\u6cbb\u7fa4\u5cf6,\u65d7\u5b50 \u5357\u4f50\u6cbb\u4e9e\u5cf6\u8207\u5357\u6851\u5a01\u5947\u7fa4\u5cf6\n\ud83c\uddec\ud83c\uddf9=>\u65d7 \u5371\u5730\u9a6c\u62c9,\u65d7\u5b50 \u74dc\u5730\u99ac\u62c9,\u65d7\u5b50 \u5371\u5730\u99ac\u62c9\n\ud83c\uddec\ud83c\uddfa=>\u65d7 \u5173\u5c9b,\u65d7\u5b50 \u95dc\u5cf6\n\ud83c\uddec\ud83c\uddfc=>\u65d7 \u51e0\u5185\u4e9a\u6bd4\u7ecd,\u65d7\u5b50 \u5e7e\u5167\u4e9e\u6bd4\u7d22,\u65d7\u5b50 \u5e7e\u5167\u4e9e\u6bd4\u7d39\n\ud83c\uddec\ud83c\uddfe=>\u65d7 \u572d\u4e9a\u90a3,\u65d7\u5b50 \u84cb\u4e9e\u90a3,\u65d7\u5b50 \u572d\u4e9e\u90a3\n\ud83c\udded\ud83c\uddf0=>\u65d7 \u4e2d\u56fd\u9999\u6e2f\u7279\u522b\u884c\u653f\u533a,\u65d7\u5b50 \u4e2d\u570b\u9999\u6e2f\u7279\u5225\u884c\u653f\u5340\n\ud83c\udded\ud83c\uddf2=>\u6