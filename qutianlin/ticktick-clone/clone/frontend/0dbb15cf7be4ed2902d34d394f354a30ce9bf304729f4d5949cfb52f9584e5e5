d7 \u5362\u68ee\u5821,\u65d7\u5b50 \u76e7\u68ee\u5821\n\ud83c\uddf1\ud83c\uddfb=>\u65d7 \u62c9\u8131\u7ef4\u4e9a,\u65d7\u5b50 \u62c9\u812b\u7dad\u4e9e\n\ud83c\uddf1\ud83c\uddfe=>\u65d7 \u5229\u6bd4\u4e9a,\u65d7\u5b50 \u5229\u6bd4\u4e9e\n\ud83c\uddf2\ud83c\udde6=>\u65d7 \u6469\u6d1b\u54e5,\u65d7\u5b50 \u6469\u6d1b\u54e5\n\ud83c\uddf2\ud83c\udde8=>\u65d7 \u6469\u7eb3\u54e5,\u65d7\u5b50 \u6469\u7d0d\u54e5\n\ud83c\uddf2\ud83c\udde9=>\u65d7 \u6469\u5c14\u591a\u74e6,\u65d7\u5b50 \u6469\u723e\u591a\u74e6\n\ud83c\uddf2\ud83c\uddea=>\u65d7 \u9ed1\u5c71,\u65d7\u5b50 \u8499\u7279\u5167\u54e5\u7f85,\u65d7\u5b50 \u9ed1\u5c71\n\ud83c\uddf2\ud83c\uddeb=>\u65d7 \u6cd5\u5c5e\u5723\u9a6c\u4e01,\u65d7\u5b50 \u6cd5\u5c6c\u8056\u99ac\u4e01\n\ud83c\uddf2\ud83c\uddec=>\u65d7 \u9a6c\u8fbe\u52a0\u65af\u52a0,\u65d7\u5b50 \u99ac\u9054\u52a0\u65af\u52a0\n\ud83c\uddf2\ud83c\udded=>\u65d7 \u9a6c\u7ecd\u5c14\u7fa4\u5c9b,\u65d7\u5b50 \u99ac\u7d39\u723e\u7fa4\u5cf6\n\ud83c\uddf2\ud83c\uddf0=>\u65d7 \u5317\u9a6c\u5176\u987f,\u65d7\u5b50 \u5317\u99ac\u5176\u9813\n\ud83c\uddf2\ud83c\uddf1=>\u65d7 \u9a6c\u91cc,\u65d7\u5b50 \u99ac\u5229,\u65d7\u5b50 \u99ac\u91cc\n\ud83c\uddf2\ud83c\uddf2=>\u65d7 \u7f05\u7538,\u65d7\u5b50 \u7dec\u7538\n\ud83c\uddf2\ud83c\uddf3=>\u65d7 \u8499\u53e4,\u65d7\u5b50 \u8499\u53e4\n\ud83c\uddf2\ud83c\uddf4=>\u65d7 \u4e2d\u56fd\u6fb3\u95e8\u7279\u522b\u884c\u653f\u533a,\u65d7\u5b50 \u4e2d\u570b\u6fb3\u9580\u7279\u5225\u884c\u653f\u5340\n\ud83c\uddf2\ud83c\uddf5=>\u65d7 \u5317\u9a6c\u91cc\u4e9a\u7eb3\u7fa4\u5c9b,\u65d7\u5b50 \u5317\u99ac\u5229\u5b89\u7d0d\u7fa4\u5cf6\n\ud83c\uddf2\ud83c\uddf6=>\u65d7 \u9a6c\u63d0\u5c3c\u514b,\u65d7\u5b50 \u99ac\u4e01\u5c3c\u514b\n\ud83c\uddf2\ud83c\uddf7=>\u65d7 \u6bdb\u91cc\u5854\u5c3c\u4e9a,\u65d7\u5b50 \u8305\u5229\u5854\u5c3c\u4e9e,\u65d7\u5b50 \u6bdb\u91cc\u5854\u5c3c\u4e9e\n\ud83c\uddf2\ud83c\uddf8=>\u65d7 \u8499\u7279\u585e\u62c9\u7279,\u65d7\u5b50 \u8499\u54f2\u81d8,\u65d7\u5b50 \u8499\u7279\u585e\u62c9\u7279\n\ud83c\uddf2\ud83c\uddf9=>\u6