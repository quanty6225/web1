3bf\u03c5\u03c2 \u03b3\u03b9\u03b1 \u03c4\u03b7\u03bd \u03bf\u03bc\u03ac\u03b4\u03b1 \u03c3\u03b1\u03c2 \u03bf\u03c0\u03bf\u03c4\u03b5\u03b4\u03ae\u03c0\u03bf\u03c4\u03b5 \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7 \u03b4\u03b9\u03ac\u03c1\u03ba\u03b5\u03b9\u03b1 \u03c4\u03b7\u03c2 \u03c0\u03b5\u03c1\u03b9\u03cc\u03b4\u03bf\u03c5 \u03b9\u03c3\u03c7\u03cd\u03bf\u03c2 \u03c4\u03b7\u03c2 \u03bf\u03bc\u03ac\u03b4\u03b1\u03c2. \u03a0\u03b7\u03b3\u03b1\u03af\u03bd\u03b5\u03c4\u03b5 \u03c3\u03c4\u03b9\u03c2 \\"\u03a1\u03c5\u03b8\u03bc\u03af\u03c3\u03b5\u03b9\u03c2\\" - \\"\u039c\u03ad\u03bb\u03b7\\" \u03ba\u03b1\u03b9 \u03ba\u03ac\u03bd\u03c4\u03b5 \u03ba\u03bb\u03b9\u03ba \u03c3\u03c4\u03bf \\"\u0395\u03c0\u03ad\u03ba\u03c4\u03b1\u03c3\u03b7\\".","team_answer_5_content_3":"\u039a\u03cc\u03c3\u03c4\u03bf\u03c2 \u03a0\u03c1\u03bf\u03c3\u03b8\u03ae\u03ba\u03b7\u03c2 \u0398\u03ad\u03c3\u03b5\u03c9\u03bd \u039c\u03ad\u03bb\u03bf\u03c5\u03c2 = 199/\u03ac\u03c4\u03bf\u03bc\u03bf/\u03ad\u03c4\u03bf\u03c2 \xf7 365 \u03b7\u03bc\u03ad\u03c1\u03b5\u03c2 \xd7 \u0391\u03c1\u03b9\u03b8\u03bc\u03cc\u03c2 \u03a0\u03c1\u03bf\u03c3\u03c4\u03b9\u03b8\u03ad\u03bc\u03b5\u03bd\u03c9\u03bd \u0398\u03ad\u03c3\u03b5\u03c9\u03bd \u039c\u03ad\u03bb\u03bf\u03c5\u03c2 \xd7 \u03a5\u03c0\u03cc\u03bb\u03bf\u03b9\u03c0\u03b5\u03c2 \u0397\u03bc\u03ad\u03c1\u03b5\u03c2","team_answer_5_content_4":"\u039c\u03b5\u03af\u03c9\u03c3\u03b7 \u03b8\u03ad\u03c3\u03b5\u03c9\u03bd \u03bc\u03b5\u03bb\u03ce\u03bd","team_answer_5_content_5":"\u039c\u03c0\u03bf\u03c1\u03b5\u03af\u03c4\u03b5 \u03bd\u03b1 \u03b5\u03c0\u03b9\u03ba\u03bf\u03b9\u03bd\u03c9\u03bd\u03ae\u03c3\u03b5\u03c4\u03b5 \u03bc\u03b1\u03b6\u03af \u03bc\u03b1\u03c2 \u03bf\u03c0\u03bf\u03b9\u03b1\u03b4\u03ae\u03c0\u03bf\u03c4\u03b5 \u03c3\u03c4\u03b9\u03b3\u03bc\u03ae \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7 \u03b4\u03b9\u03ac\u03c1\u03ba\u03b5\u03b9\u03b1 \u03c4\u03b7\u03c2 \u03c0\u03b5\u03c1\u03b9\u03cc\u03b4\u03bf\u03c5 \u03b9\u03c3\u03c7\u03cd\u03bf\u03c2 \u03c4\u