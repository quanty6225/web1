u043c\u0430\u043d\u0434\u0438. \u0412\u0430\u0440\u0442\u0456\u0441\u0442\u044c \u0437\u043c\u0435\u043d\u0448\u0435\u043d\u043d\u044f \u043c\u0456\u0441\u0446\u044c \u0434\u043b\u044f \u0447\u043b\u0435\u043d\u0456\u0432 \u0431\u0443\u0434\u0435 \u043f\u0435\u0440\u0435\u0432\u0435\u0434\u0435\u043d\u0430 \u0432 \u0434\u043d\u0456 \u0456 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u0430 \u0434\u043b\u044f \u043f\u0440\u043e\u0434\u043e\u0432\u0436\u0435\u043d\u043d\u044f \u0442\u0435\u0440\u043c\u0456\u043d\u0443 \u0432\u0430\u0448\u043e\u0433\u043e \u0447\u043b\u0435\u043d\u0441\u0442\u0432\u0430 \u0443 \u043a\u043e\u043c\u0430\u043d\u0434\u0456.","team_answer_5_content_6":"\u0417\u0431\u0456\u043b\u044c\u0448\u0435\u043d\u0430 \u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u0434\u043d\u0456\u0432 \u0447\u043b\u0435\u043d\u0441\u0442\u0432\u0430 = \u0412\u0430\u0440\u0442\u0456\u0441\u0442\u044c \u043d\u0435 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u0438\u0445 \u0437\u043c\u0435\u043d\u0448\u0435\u043d\u0438\u0445 \u043c\u0456\u0441\u0446\u044c \xf7 \u0414\u0435\u043d\u043d\u0430 \u0446\u0456\u043d\u0430 \xf7 \u0417\u0430\u043b\u0438\u0448\u0438\u043b\u043e\u0441\u044c \u043c\u0456\u0441\u0446\u044c.","team_answer_5_content_7":"\u0411\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u043f\u043e\u044f\u0441\u043d\u0456\u0442\u044c \u0441\u0432\u043e\u0457 \u0437\u043c\u0435\u043d\u0448\u0435\u043d\u0456 \u043f\u043e\u0442\u0440\u0435\u0431\u0438 \u0432 \u043c\u0456\u0441\u0446\u044f\u0445 \u0443 \u0440\u043e\u0437\u0434\u0456\u043b\u0456 \\"\u0414\u043e\u0432\u0456\u0434\u043a\u0430 \u0442\u0430 \u0437\u0432\u043e\u0440\u043e\u0442\u043d\u0456\u0439 \u0437\u0432\'\u044f\u0437\u043e\u043a\\", \u0456 \u043c\u0438 \u043e\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u043e \u0437\u0440\u0435\u0430\u0433\u0443\u0454\u043c\u043e \u043d\u0430 \u0432\u0430\u0448 \u0437\u0430\u043f\u0438\u0442 \u0442\u0430 \u043e\u0431\u0440\u043e\u0431\u0438\u043c\u043e \u0439\u043e\u0433\u043e.","team_faq_7":"\u0427\u0438 \u043c\u043e\u0436\u043d\u0430 \u0432\u0438\u0434\u0430\u0442\u0438 \u0440\u0430\u0445\u0443\u043d\u043e\u043a-\u0444\u0430\u043a\u0442\u0443\u0440\u0443?","team_answer_7_content_1":"\u041f\u0456\u0441\u043b\u044f \u0443\u0441\u043f\u0456\u0448\u043d\u043e\u0457 \u043e\u043f\u043b\u0430\u0442\u0438 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f, \u044f\u043a\u0449\u043e \u0432\u0430\u043c \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u0432\u0438\u0441\u0442\u0430\u0432\u0438\u0442\u0438 \u0440\u0430\u0445\u0443\u043d\u043e\u043a-\u0444\u0430\u043a\u0442\u0443\u0440\u0443, \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0432\u0438\u0431\u0440\u0430\u0442\u0438 \\"\u0420\u0430\u0445\u0443\u043d\u043e\u043a-\u0444\u0430\u043a\u0442\u0443\u0440\u0443\\" \u043d\u0430 \u0441\u0442\u043e\u0440\u0456\u043d\u0446\u0456 \\"\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f\\" - \\"\u0423\u043f\u0440\u0430\u0432\u043b\u0456\u043d\u043d\u044f \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f\u043c\u0438\\" \u043a\u043e\u043c\u0430\u043d\u0434\u0438, \u0437\u0430\u043f\u043e\u0432\u043d\u0438\u0442\u0438 \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u044e \u043f\u0440\u043e \u0440\u0430\u0445\u0443\u043d\u043e\u043a-\u0444\u0430\u043a\u0442\u0443\u0440\u0443, \u0456 \u0432\u0438 \u0437\u043c\u043e\u0436\u0435\u0442\u0435 \u0432\u0438\u0441\u0442\u0430\u0432\u0438\u0442\u0438 \u0440\u0430\u0445\u0443\u043d\u043e\u043a-\u0444\u0430\u043a\u0442\u0443\u0440\u0443.","team_faq_6":"\u0427\u0438 \u043c\u043e\u0436\u043d\u0430 \u043f\u043e\u0434\u0430\u0442\u0438 \u0437\u0430\u044f\u0432\u043a\u0443 \u043d\u0430 \u043f\u043e\u0432\u0435\u0440\u043d\u0435\u043d\u043d\u044f \u043a\u043e\u0448\u0442\u0456\u0432 \u043f\u0456\u0441\u043b\u044f \u043e\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0447\u043b\u0435\u043d\u0441\u0442\u0432\u0430 