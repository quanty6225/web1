\u043d\u0430 \u0447\u043b\u0435\u043d \u043e\u0442 \u0435\u043a\u0438\u043f\u0430.","team_faq_4":"\u041a\u0430\u043a\u0432\u043e \u0442\u0440\u044f\u0431\u0432\u0430 \u0434\u0430 \u043d\u0430\u043f\u0440\u0430\u0432\u044f, \u0430\u043a\u043e \u0441\u043b\u0435\u0434 \u0438\u0437\u0442\u0438\u0447\u0430\u043d\u0435 \u043d\u0430 \u0447\u043b\u0435\u043d\u0441\u0442\u0432\u043e\u0442\u043e \u0435 \u043f\u0440\u0435\u0432\u0438\u0448\u0435\u043d\u043e \u0431\u0435\u0437\u043f\u043b\u0430\u0442\u043d\u043e\u0442\u043e \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0435?","team_answer_4_content_1":"\u0421\u043b\u0435\u0434 \u0438\u0437\u0442\u0438\u0447\u0430\u043d\u0435 \u043d\u0430 \u0447\u043b\u0435\u043d\u0441\u0442\u0432\u043e\u0442\u043e \u0432\u0438, \u0432\u0441\u0435 \u043e\u0449\u0435 \u043c\u043e\u0436\u0435\u0442\u0435 \u0434\u0430 \u043f\u0440\u0435\u0433\u043b\u0435\u0436\u0434\u0430\u0442\u0435 \u0438 \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u0442\u0435 \u0441\u044a\u0449\u0435\u0441\u0442\u0432\u0443\u0432\u0430\u0449\u043e\u0442\u043e \u0441\u044a\u0434\u044a\u0440\u0436\u0430\u043d\u0438\u0435 \u043d\u0430 \u0441\u043f\u0438\u0441\u044a\u043a\u0430 \u0441 \u043e\u0442\u0431\u043e\u0440\u0430 \u043d\u043e\u0440\u043c\u0430\u043b\u043d\u043e, \u043d\u043e \u043d\u0435 \u043c\u043e\u0436\u0435\u0442\u0435 \u0434\u0430 \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u0442\u0435 \u0434\u0440\u0443\u0433\u0438 \u043f\u043b\u0430\u0442\u0435\u043d\u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u0438.","team_faq_5":"\u041a\u0430\u043a \u0441\u0435 \u0438\u0437\u0447\u0438\u0441\u043b\u044f\u0432\u0430 \u0442\u0430\u043a\u0441\u0430\u0442\u0430 \u0437\u0430 \u043f\u0440\u043e\u043c\u044f\u043d\u0430 \u043d\u0430 \u0431\u0440\u043e\u044f \u043d\u0430 \u043c\u0435\u0441\u0442\u0430\u0442\u0430 \u0437\u0430 \u0447\u043b\u0435\u043d\u043e\u0432\u0435\u0442\u0435?","team_answer_5_content_1":"\u0423\u0432\u0435\u043b\u0438\u0447\u0430\u0432\u0430\u043d\u0435 \u043d\u0430 \u0431\u0440\u043e\u044f \u043d\u0430 \u043c\u0435\u0441\u0442\u0430\u0442\u0430 \u0437\u0430 \u0447\u043b\u0435\u043d\u043e\u0432\u0435.","team_answer_5_content_2":"\u041c\u043e\u0436\u0435\u0442\u0435 \u0434\u0430 \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0442\u0435 \u0431\u0440\u043e\u044f \u043d\u0430 \u043c\u0435\u0441\u0442\u0430\u0442\u0430 \u0437\u0430 \u0447\u043b\u0435\u043d\u043e\u0432\u0435 \u043d\u0430 \u0432\u0430\u0448\u0438\u044f \u0435\u043a\u0438\u043f \u043f\u043e \u0432\u0441\u044f\u043a\u043e \u0432\u0440\u0435\u043c\u0435 \u043f\u043e \u0432\u0440\u0435\u043c\u0435 \u043d\u0430 \u043f\u0435\u0440\u0438\u043e\u0434\u0430 \u043d\u0430 \u0447\u043b\u0435\u043d\u0441\u0442\u0432\u043e\u0442\u043e \u0432 \u0435\u043a\u0438\u043f\u0430. \u041e\u0442\u0438\u0434\u0435\u0442\u0435 \u0432 \\"\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438\\" - \\"\u0427\u043b\u0435\u043d\u043e\u0432\u0435\\" \u0438 \u0449\u0440\u0430\u043a\u043d\u0435\u0442\u0435 \u0432\u044a\u0440\u0445\u0443 \\"\u0420\u0430\u0437\u0448\u0438\u0440\u044f\u0432\u0430\u043d\u0435\\".","team_answer_5_content_3":"\u0426\u0435\u043d\u0430\u0442\u0430 \u0437\u0430 \u0434\u043e\u0431\u0430\u0432\u044f\u043d\u0435 \u043d\u0430 \u043c\u0435\u0441\u0442\u0430 \u0437\u0430 \u0447\u043b\u0435\u043d\u043e\u0432\u0435 = 199/\u0447\u043e\u0432\u0435\u043a/\u0433\u043e\u0434\u0438\u043d\u0430 \xf7 365 \u0434\u043d\u0438 \xd7 \u0411\u0440\u043e\u0439 \u0434\u043e\u0431\u0430\u0432\u0435\u043d\u0438 \u043c\u0435\u0441\u0442\u0430 \u0437\u0430 \u0447\u043b\u0435\u043d\u043e\u0432\u0435 \xd7 \u041e\u0441\u0442\u0430\u0432\u0430\u0449\u0438\u0442\u0435 \u0434\u043d\u0438.","team_answer_5_content_4":"\u041d\u0430\u043c\u0430\u043b\u044f\u0432\u0430\u043d\u0435 \u043d\u0430 \u0447\u043b\u0435\u043d\u0441\u043a\u0438\u0442\u0435 \u043c\u0435\u0441\u0442\u0430.","team_answer_5_content_5":"\u041f\u0440\u0435\u0437 \u043f\u0435\u0440\u0438\u043e\u0434\u0430 \u043d\u0430 \u0432\u04